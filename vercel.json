{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/api/thanks"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/feed-en.xml",
      "destination": "/api/feed-en"
    }
  ],
  "crons": [
    {
      "path": "/api/wayforpay-reconcile",
      "schedule": "*/10 * * * *"
    }
  ],
  "buildCommand": "node scripts/seed-sexy-set.cjs && node scripts/seed-bad-baby.cjs",
  "outputDirectory": "."
}
